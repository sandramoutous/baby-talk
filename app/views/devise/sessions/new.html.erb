<section class="account">
  <header class="account__header">
    <h1>Se connecter</h1>
  </header>

  <div class="account__card">
    <%= form_for(resource, as: resource_name,
                 url: new_session_path(resource_name),
                 html: { class: "form" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form__field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="form__field">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <% if @minimum_password_length %>
          <span class="form__help"><%= @minimum_password_length %> caractères minimum</span>
        <% end %>
      </div>

      <%= f.submit "Me connecter", class: "button button--primary" %>
    <% end %>
  </div>

  <div class="account__actions">
    <%= link_to "Créer un compte", new_user_registration_path, class: "button button--ghost" %>
  </div>
</section>
