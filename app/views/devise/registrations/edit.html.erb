


<section class="account">
  <header class="account__header">
    <h1>Modifier mes identifiants</h1>
  </header>

  <div class="account__card">
    <%= form_for(resource, as: resource_name,
                 url: registration_path(resource_name),
                 html: { method: :put, class: "form" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form__field">
        <%= f.label :email, "Adresse e-mail" %>
        <%= f.email_field :email, autocomplete: "email", required: true %>
      </div>

      <hr class="form__separator">

      <p class="form__hint">
        Laissez les deux champs suivants vides si vous ne souhaitez pas
        changer de mot de passe.
      </p>

      <div class="form__field">
        <%= f.label :password, "Nouveau mot de passe" %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <% if @minimum_password_length %>
          <span class="form__help"><%= @minimum_password_length %> caractères minimum</span>
        <% end %>
      </div>

      <div class="form__field">
        <%= f.label :password_confirmation, "Confirmation" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <hr class="form__separator">

      <div class="form__field">
        <%= f.label :current_password, "Mot de passe actuel" %>
        <%= f.password_field :current_password, autocomplete: "current-password", required: true %>
        <span class="form__help">Nécessaire pour confirmer les modifications</span>
      </div>

      <%= f.submit "Enregistrer", class: "button button--primary" %>
    <% end %>
  </div>

  <div class="account__actions">
    <%= link_to "Retour à mon compte", user_path, class: "button button--ghost" %>
  </div>
</section>
