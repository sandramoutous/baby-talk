<div class="dashboard">
  <div class="dashboard-header">
    <div class="title-row">
      <%= link_to children_path, class: "back-button" do %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      <% end %>
      <h1><%= @child.name %></h1>
    </div>
    <details class="menu">
      <summary class="icon-action" title="Options" aria-label="Options">
        <%= icon :menu %>
      </summary>
      <div class="menu-dropdown">
        <%= link_to "Modifier la fiche", edit_child_path(@child), class: "menu-item" %>
        <%= link_to "Imprimer l'affiche", printout_child_path(@child), class: "menu-item" %>
        <%= button_to "Supprimer #{@child.name}", child_path(@child), method: :delete,
                      class: "menu-item menu-item--danger",
                      form: { data: { turbo_confirm: "Supprimer #{@child.name} et tous ses mots ?" } } %>
      </div>
    </details>
    <%= link_to "+ Ajouter un mot", new_child_word_path(@child), class: "button button--secondary button--full" %>
  </div>
  <%#= link_to edit_word_path(word), class: "word-action", title: "Modifier",
            aria: { label: "Modifier" } do %>
    <%#= icon :pencil %>
  <%# end %>

  <table>
    <% @words.each do |word| %>
      <tr class="words-list">
        <td class="word-item">
          <div class="word-main">
            <span class="word-baby-version">« <%= word.baby_version %> »</span>
            <br>
            <span class="word-arrow">→</span>
            <span class="word-real-meaning"><%= word.real_meaning %></span>
            <br>
            <%= word.said_on&.strftime("%d/%m/%Y") %>
          </div>
          <div>
            <% if word.audio.attached? %>
              <audio controls preload="none" src="<%= url_for(word.audio) %>"></audio>
            <% end %>
          </div>
        </td>
        <td class="word-date"><%= word.said_on&.strftime("%d/%m/%Y") %></td>
        <td>
          <div class="word-actions">
            <%= link_to "Modifier", edit_child_word_path(@child, word) %>
            <%= link_to "Supprimer", child_word_path(@child, word), data: { turbo_method: :delete, turbo_confirm: "Supprimer ce mot ?" } %>
          </div>
        </td>
      </tr>
    <% end %>
  </table>

  <% if @words.empty? %>
    <p class="empty-state">Aucun mot enregistré pour l'instant.</p>
  <% end %>
</div>
