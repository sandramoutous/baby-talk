<%= form_with model: [@child, @word], local: true, class: "auth-card" do |f| %>
  <div class="field">
    <%= f.label :baby_version, "Ce qu'il/elle a dit" %>
    <%= f.text_field :baby_version, placeholder: "mani" %>
  </div>

  <div class="field">
    <%= f.label :real_meaning, "Ce que ça voulait dire" %>
    <%= f.text_field :real_meaning, placeholder: "merci" %>
  </div>

  <div class="field">
    <%= f.label :context, "Contexte (optionnel)" %>
    <%= f.text_area :context, placeholder: "Le disait à chaque fin de repas..." %>
  </div>

  <div class="field">
    <%= f.label :said_on, "Dit le" %>
    <%= f.date_field :said_on %>
  </div>

  <div class="field">
    <% if @word.audio.attached? %>
      <p class="field__label">Enregistrement actuel</p>
      <audio controls preload="none" src="<%= url_for(@word.audio) %>"></audio>

      <label class="field__checkbox">
        <%= f.check_box :remove_audio %>
        Supprimer cet enregistrement
      </label>

      <%= f.label :audio, "Remplacer l'enregistrement (optionnel)" %>
    <% else %>
      <%= f.label :audio, "Enregistrement (optionnel)" %>
    <% end %>
    <%= f.file_field :audio, accept: "audio/*" %>
  </div>

  <!--
  TODO évolution : enregistrement micro direct
   <div data-controller="bridge--recorder">
    <%= f.file_field :audio, accept: "audio/*",
          data: { "bridge--recorder-target": "input" },
          style: "display: none;" %>

    <button type="button"
            class="btn-secondary"
            data-action="bridge--recorder#toggle"
            data-bridge--recorder-target="button">
      🎤 Enregistrer
    </button>

    <audio controls
          data-bridge--recorder-target="preview"
          class="hidden"></audio>
  </div>
  -->
  <div class="actions">
    <%= f.submit "Enregistrer", class: "btn-primary" %>
  </div>
<% end %>
